<!-- default list view for Set-IniValue -->
<View> 
	<Name>Powertools.GetSSLCertificate.Result</Name>
	<ViewSelectedBy>
		<TypeName>Powertools.GetSSLCertificate.Result</TypeName>
	</ViewSelectedBy>
	<ListControl>
		<ListEntries>
			<ListEntry>
				<ListItems>
					<ListItem>
						<Label>Subject</Label>
						<PropertyName>Subject</PropertyName>
					</ListItem>
					<ListItem>
						<Label>SubjectAlternativeNames</Label>
						<PropertyName>SubjectAlternativeNames</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Issuer</Label>
						<PropertyName>Issuer</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Verified</Label>
						<PropertyName>
							<ScriptBlock>
                  				if ($_.Verified -eq "False") {
                      				"$([char]0x1b)[1;91m$($_.Verified)$([char]0x1b)[0m"
                  				}
                  				else {
                      				$_.Verified
                  				}
                			</ScriptBlock>
						</PropertyName>
					</ListItem>
					<ListItem>
						<Label>NotBefore</Label>
						<PropertyName>
						<ScriptBlock>
                  				if ($_.NotBefore -gt (Get-Date)) {
                      				"$([char]0x1b)[1;91m$($_.NotBefore)$([char]0x1b)[0m"
                  				}
								else {
									$_.NotBefore
								}
						</ScriptBlock>
						</PropertyName>
					</ListItem>	
					<ListItem>
						<Label>NotAfter</Label>
						<PropertyName>
						<ScriptBlock>
                  				if ($_.NotAfter -lt (Get-Date)) {
                      				"$([char]0x1b)[1;91m$($_.NotAfter)$([char]0x1b)[0m"
                  				}
								else {
									$_.NotAfter
								}
						</ScriptBlock>
						</PropertyName>
					</ListItem>	
					<ListItem>
						<Label>SignatureAlgorithm</Label>
						<PropertyName>SignatureAlgorithm</PropertyName>
					</ListItem>
					<ListItem>
						<Label>PublicKeyAlgorithm</Label>
						<PropertyName>PublicKeyAlgorithm</PropertyName>
					</ListItem>
					<ListItem>
						<Label>PublicKeySize</Label>
						<PropertyName>PublicKeySize</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Thumbprint</Label>
						<PropertyName>Thumbprint</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Version</Label>
						<PropertyName>Version</PropertyName>
					</ListItem>			
				</ListItems>
			</ListEntry>
		</ListEntries>
	</ListControl>
</View>


</ViewDefinitions>
</Configuration>


