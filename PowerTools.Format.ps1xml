<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
<ViewDefinitions>

<!-- default table view for Get-Netstat -->	
	<View> 
		<Name>Powertools.GetNetstat.Result</Name>
		<ViewSelectedBy>
			<TypeName>Powertools.GetNetstat.Result</TypeName>
		</ViewSelectedBy>
		<TableControl>
			<TableHeaders>
				<TableColumnHeader>
					<Label>Protocol</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>LocalIPAddress</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>LocalPort</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>RemoteIPAddress</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>RemotePort</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>State</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>ProcessName</Label>
				</TableColumnHeader>
			</TableHeaders>
			<TableRowEntries>
				<TableRowEntry>
					<TableColumnItems>
						<TableColumnItem>
							<PropertyName>Protocol</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>LocalIPAddress</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>LocalPort</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>RemoteIPAddress</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>RemotePort</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>State</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>ProcessName</PropertyName>
						</TableColumnItem>
					</TableColumnItems>
				</TableRowEntry>
			</TableRowEntries>
		</TableControl>
	</View>

<!-- default table view for Connect-TCPPort -->	
	<View> 
		<Name>Powertools.TestTCPPort.Result</Name>
		<ViewSelectedBy>
			<TypeName>Powertools.TestTCPPort.Result</TypeName>
		</ViewSelectedBy>
		<TableControl>
			<TableHeaders>
				<TableColumnHeader>
					<Label>Connection</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>ElapsedTime</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>RemoteHost</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>Port</Label>
				</TableColumnHeader>
			</TableHeaders>
			<TableRowEntries>
				<TableRowEntry>
					<TableColumnItems>
						<TableColumnItem>
							<PropertyName>Connection</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>ElapsedTime</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>RemoteHost</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>Port</PropertyName>
						</TableColumnItem>
					</TableColumnItems>
				</TableRowEntry>
			</TableRowEntries>
		</TableControl>
	</View>

<!-- default list view for Test-Database -->
<View> 
	<Name>Powertools.TestDatabase.Result</Name>
	<ViewSelectedBy>
		<TypeName>Powertools.TestDatabase.Result</TypeName>
	</ViewSelectedBy>
	<ListControl>
		<ListEntries>
			<ListEntry>
				<ListItems>
					<ListItem>
						<Label>Connection</Label>
						<PropertyName>Connection</PropertyName>
					</ListItem>
					<ListItem>
						<Label>ElapsedTime</Label>
						<PropertyName>ElapsedTime</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Server</Label>
						<PropertyName>Server</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Database</Label>
						<PropertyName>Database</PropertyName>
					</ListItem>
					<ListItem>
						<Label>User</Label>
						<PropertyName>User</PropertyName>
					</ListItem>
				</ListItems>
			</ListEntry>
		</ListEntries>
	</ListControl>
</View>

<!-- default table view for Show-WordMetadata -->	
<View> 
	<Name>Powertools.ShowWordMetatdata.Result</Name>
	<ViewSelectedBy>
		<TypeName>Powertools.ShowWordMetatdata.Result</TypeName>
	</ViewSelectedBy>
	<TableControl>
		<TableHeaders>
			<TableColumnHeader>
				<Label>PropertyName</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Value</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Filename</Label>
			</TableColumnHeader>
		</TableHeaders>
		<TableRowEntries>
			<TableRowEntry>
				<TableColumnItems>
					<TableColumnItem>
						<PropertyName>PropertyName</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>Value</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>FileName</PropertyName>
					</TableColumnItem>						
				</TableColumnItems>
			</TableRowEntry>
		</TableRowEntries>
	</TableControl>
</View>

