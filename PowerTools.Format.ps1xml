<!-- default table view for Show-WordMetadata -->	
<View> 
	<Name>Powertools.ExportedCredentials</Name>
	<ViewSelectedBy>
		<TypeName>Powertools.ExportedCredentials</TypeName>
	</ViewSelectedBy>
	<TableControl>
		<TableHeaders>
			<TableColumnHeader>
				<Label>Username</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Password</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>ExportUser</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>ExportHost</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>ExportDate</Label>
			</TableColumnHeader>
		</TableHeaders>
		<TableRowEntries>
			<TableRowEntry>
				<TableColumnItems>
					<TableColumnItem>
						<PropertyName>Username</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>Password</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>ExportUser</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>ExportHost</PropertyName>
					</TableColumnItem>	
					<TableColumnItem>
						<PropertyName>ExportDate</PropertyName>
					</TableColumnItem>						
				</TableColumnItems>
			</TableRowEntry>
		</TableRowEntries>
	</TableControl>
</View>


<!-- default table view for Rename-FileExtension -->	
