<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
<ViewDefinitions>


<!-- default table view for Test-TCPPort -->	
	<View> 
		<Name>Powertools.TestTCPPort.Result</Name>
		<ViewSelectedBy>
			<TypeName>Powertools.TestTCPPort.Result</TypeName>
		</ViewSelectedBy>
		<TableControl>
			<TableHeaders>
				<TableColumnHeader>
					<Label>Connection</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>SourceAddress</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>RemoteHost</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>RemoteAddress</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>Port</Label>
				</TableColumnHeader>
				<TableColumnHeader>
					<Label>ConnectionTime</Label>
				</TableColumnHeader>
			</TableHeaders>
			<TableRowEntries>
				<TableRowEntry>
					<TableColumnItems>
						<TableColumnItem>
                			<ScriptBlock>
                  			if ($_.Connection -eq "Failed") {
                      			"$([char]0x1b)[1;91m$($_.Connection)$([char]0x1b)[0m"
                  			}
                  			else {
                      			$_.Connection
                  			}
                			</ScriptBlock>
              			</TableColumnItem>
						<TableColumnItem>
							<PropertyName>SourceAddress</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>RemoteHost</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>RemoteAddress</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>Port</PropertyName>
						</TableColumnItem>
						<TableColumnItem>
							<PropertyName>ConnectionTime</PropertyName>
						</TableColumnItem>
					</TableColumnItems>
				</TableRowEntry>
			</TableRowEntries>
		</TableControl>
	</View>


<!-- default list view for Get-TLSCertificate -->
<View> 
	<Name>Powertools.GetSSLCertificate.Result</Name>
	<ViewSelectedBy>
		<TypeName>Powertools.GetSSLCertificate.Result</TypeName>
	</ViewSelectedBy>
	<ListControl>
		<ListEntries>
			<ListEntry>
				<ListItems>
					<ListItem>
						<Label>Hostname</Label>
						<PropertyName>Hostname</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Subject</Label>
						<PropertyName>Subject</PropertyName>
					</ListItem>
					<ListItem>
						<Label>SubjectAlternativeNames</Label>
						<PropertyName>SubjectAlternativeNames</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Issuer</Label>
						<PropertyName>Issuer</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Verified</Label>
						<ScriptBlock>
                  			if ($_.Verified -eq $false) {
                    			"$([char]0x1b)[1;91m$($_.Verified)$([char]0x1b)[0m"
                  			}
                  			else {
                    			$_.Verified
                  			}
                		</ScriptBlock>
					</ListItem>
					<ListItem>
						<Label>ValidFrom</Label>
						<ScriptBlock>
							$formattedDateTime = "$($_.ValidFrom.ToShortDateString()) $($_.ValidFrom.ToShortTimeString())"
                  			if ($_.ValidFrom -gt (Get-Date)) {
                      			"$([char]0x1b)[1;91m$($formattedDateTime)$([char]0x1b)[0m"
                  			}
							else {
								$formattedDateTime
							}
						</ScriptBlock>
					</ListItem>	
					<ListItem>
						<Label>ValidTo</Label>
						<ScriptBlock>
						$formattedDateTime = "$($_.ValidTo.ToShortDateString()) $($_.ValidTo.ToShortTimeString())"
                  			if ($_.ValidTo -lt (Get-Date)) {
                      			"$([char]0x1b)[1;91m$($formattedDateTime)$([char]0x1b)[0m"
                  			}
							elseif ($_.ValidTo -lt (Get-Date).AddDays(30)) {
								"$([char]0x1b)[1;93m$($formattedDateTime)$([char]0x1b)[0m"
							}
							else {
								$formattedDateTime
							}
						</ScriptBlock>
					</ListItem>	
					<ListItem>
						<Label>SignatureAlgorithm</Label>
						<PropertyName>SignatureAlgorithm</PropertyName>
					</ListItem>
					<ListItem>
						<Label>PublicKeyAlgorithm</Label>
						<PropertyName>PublicKeyAlgorithm</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Thumbprint</Label>
						<PropertyName>Thumbprint</PropertyName>
					</ListItem>
					<ListItem>
						<Label>Version</Label>
						<PropertyName>Version</PropertyName>
					</ListItem>	
					<ListItem>
						<Label>SerialNumber</Label>
						<PropertyName>SerialNumber</PropertyName>
					</ListItem>	
					<ListItem>
						<Label>EnhancedKeyUsage</Label>
						<PropertyName>EnhancedKeyUsage</PropertyName>
					</ListItem>			
				</ListItems>
			</ListEntry>
		</ListEntries>
	</ListControl>
</View>

<!-- Alternate view for Get-TLSCerificate. Simplified table view. Get-TLSCerificate -Hostname example.com | ft -view TLSCertTable -->	
<View> 
	<Name>TLSCertTable</Name>
	<ViewSelectedBy>
		<TypeName>Powertools.GetSSLCertificate.Result</TypeName>
	</ViewSelectedBy>
	<TableControl>
		<TableHeaders>
			<TableColumnHeader>
				<Label>Hostname</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>CN</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Verified</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Expires</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Issuer</Label>
			</TableColumnHeader>
		</TableHeaders>
		<TableRowEntries>
			<TableRowEntry>
				<TableColumnItems>
					<TableColumnItem>
						<PropertyName>Hostname</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<ScriptBlock>($_.Subject.Split(',') -match "CN").Trim().Replace('CN=','')</ScriptBlock>
					</TableColumnItem>			
					<TableColumnItem>
						<ScriptBlock>
                  			if ($_.Verified -eq $false) {
                    			"$([char]0x1b)[1;91m$($_.Verified)$([char]0x1b)[0m"
                  			}
                  			else {
                    			$_.Verified
                  			}
                		</ScriptBlock>
					</TableColumnItem>
					<TableColumnItem>
						<ScriptBlock>
                  			if ($_.ValidTo -lt (Get-Date)) {
                    			"$([char]0x1b)[1;91m$($_.ValidTo.ToShortDateString())$([char]0x1b)[0m"
                  			}
							elseif ($_.ValidTo -lt (Get-Date).AddDays(30)) {
								"$([char]0x1b)[1;93m$($formattedDateTime)$([char]0x1b)[0m"
							}
							else {
								$_.ValidTo.ToShortDateString()
							}
						</ScriptBlock>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>Issuer</PropertyName>
					</TableColumnItem>		
				</TableColumnItems>
			</TableRowEntry>
		</TableRowEntries>
	</TableControl>
</View>

<!-- default table view for Get-SQLInstance -->	
<View> 
	<Name>Powertools.GetSQLInstance.Result</Name>
	<ViewSelectedBy>
		<TypeName>Powertools.GetSQLInstance.Result</TypeName>
	</ViewSelectedBy>
	<TableControl>
		<TableHeaders>
			<TableColumnHeader>
				<Label>Hostname</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Computername</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>SQLInstance</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Version</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>TCPPort</Label>
			</TableColumnHeader>
		</TableHeaders>
		<TableRowEntries>
			<TableRowEntry>
				<TableColumnItems>
					<TableColumnItem>
						<PropertyName>Hostname</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>Computername</PropertyName>
					</TableColumnItem>		
					<TableColumnItem>
						<PropertyName>SQLInstance</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>Version</PropertyName>
					</TableColumnItem>	
					<TableColumnItem>
						<PropertyName>TCPPort</PropertyName>
					</TableColumnItem>			
				</TableColumnItems>
			</TableRowEntry>
		</TableRowEntries>
	</TableControl>
</View>

<!-- default table view for Get-NetworkLatency -->	
<View> 
	<Name>Powertools.GetNetworkLatency.SummaryResult</Name>
	<ViewSelectedBy>
		<TypeName>Powertools.GetNetworkLatency.SummaryResult</TypeName>
	</ViewSelectedBy>
	<TableControl>
		<TableHeaders>
			<TableColumnHeader>
				<Label>Destination</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Average</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Minimum</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Maximum</Label>
			</TableColumnHeader>
			<TableColumnHeader>
				<Label>Loss</Label>
			</TableColumnHeader>
		</TableHeaders>
		<TableRowEntries>
			<TableRowEntry>
				<TableColumnItems>
					<TableColumnItem>
						<PropertyName>Destination</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>Average</PropertyName>
					</TableColumnItem>		
					<TableColumnItem>
						<PropertyName>Minimum</PropertyName>
					</TableColumnItem>
					<TableColumnItem>
						<PropertyName>Maximum</PropertyName>
					</TableColumnItem>	
					<TableColumnItem>
						<PropertyName>Loss</PropertyName>
					</TableColumnItem>			
				</TableColumnItems>
			</TableRowEntry>
		</TableRowEntries>
	</TableControl>
</View>


</ViewDefinitions>
</Configuration>


